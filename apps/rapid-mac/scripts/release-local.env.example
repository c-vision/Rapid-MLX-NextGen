# release-local.env.example — copy to ~/.rapid-release.env and fill in.
#
#   cp scripts/release-local.env.example ~/.rapid-release.env
#   chmod 600 ~/.rapid-release.env
#
# This file holds IDENTIFIERS only — no private key. The App Store Connect
# .p8 lives at AC_API_KEY_PATH, placed there by you (see RELEASING.md
# Part C for the full checklist). Never commit ~/.rapid-release.env.

# App Store Connect notary key id — the "<KEYID>" in AuthKey_<KEYID>.p8.
# Replace in BOTH lines below (the path embeds the same id).
export AC_API_KEY_ID="REPLACE_WITH_KEY_ID"

# Path to the .p8 you placed yourself. Read by notarytool, not by the assistant.
export AC_API_KEY_PATH="$HOME/.appstoreconnect/private_keys/AuthKey_REPLACE_WITH_KEY_ID.p8"

# Issuer ID: App Store Connect → Users and Access → Integrations →
# App Store Connect API → the "Issuer ID" UUID at the top.
export AC_API_ISSUER_ID="PUT-ISSUER-UUID-HERE"

# Optional: pin the Developer ID Application signing identity (SHA-1 or full
# name from `security find-identity -v -p codesigning`). Leave blank to
# auto-detect the first Developer ID Application identity in your keychain —
# release-local.sh sources this file before auto-detecting, so a blank value
# here does not override detection.
export CODESIGN_IDENTITY=""
